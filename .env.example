# Required for live AI reconciliation and brief generation.
# Without this set, Countersign automatically falls back to a
# hardcoded demo result so the app always works end to end.
ANTHROPIC_API_KEY=

# Required for real two-party shared rooms (each side signs from their own
# device). Point at an Upstash Redis REST database. If neither pair below is
# set, Countersign falls back to local "Demo mode" (both sides on one screen).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative names, e.g. when using Vercel's Redis/KV integration — used
# automatically if the UPSTASH_* variables above aren't set.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
